{
  "name": "swarm-genesis",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-orchestrator agent OS with a Pixel Agents-style office",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
